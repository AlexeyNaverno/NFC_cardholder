<?xml version="1.0" encoding="utf-8"?>
<!-- Highlight of the slot that waits for a tag during a copy operation. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/slot_corner" />
    <solid android:color="@color/slot_pending_fill" />
    <stroke
        android:width="@dimen/slot_stroke"
        android:color="@color/slot_pending_stroke"
        android:dashGap="4dp"
        android:dashWidth="6dp" />
</shape>
